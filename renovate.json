{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "kubernetes": {
    "managerFilePatterns": ["/\\.ya?ml$/"]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/(^|/)values\\.ya?ml$/",
      "/(^|/)helmrelease\\.ya?ml$/"
    ]
  },
  "flux": {
    "managerFilePatterns": [
      "/(^|/)helmrelease\\.ya?ml$/",
      "/(^|/)helm-repositories\\.ya?ml$/"
    ]
  },
  "reviewers": ["emreorta"],
  "assignees": ["emreorta"]
}
